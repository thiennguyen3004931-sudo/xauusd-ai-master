# Copy this file to .env.phase7b-telegram and fill in real values.
# .env.phase7b-telegram is ignored by git; never commit the bot token.

ZIQ_TELEGRAM_BOT_TOKEN=123456789:REPLACE_WITH_BOTFATHER_TOKEN
ZIQ_TELEGRAM_CHAT_ID=REPLACE_WITH_CHAT_ID

# Optional: Telegram forum topic/thread ID. Leave blank for normal private/group chats.
ZIQ_TELEGRAM_MESSAGE_THREAD_ID=

# Optional: HTTPS URL reachable from your phone. If set, Telegram messages show a monitor button.
ZIQ_TELEGRAM_MONITOR_URL=

# Send one startup message when notifier is initialized.
ZIQ_TELEGRAM_SEND_STARTUP=true

# false = start from new journal events only (recommended, avoids Telegram spam on first launch).
ZIQ_TELEGRAM_REPLAY_EXISTING=false

ZIQ_TELEGRAM_SYMBOL=XAUUSD
