PORT=3001
HOST=127.0.0.1
WEB_ORIGIN=http://127.0.0.1:5173,http://localhost:5173,http://localhost:5174

# MT5 telemetry integration only.
# apps/api exposes GET telemetry endpoints only; it exposes no order/close/modify endpoint.
MT5_BRIDGE_ENABLED=false
MT5_BRIDGE_BASE_URL=http://127.0.0.1:8765
MT5_BRIDGE_API_KEY=
MT5_BRIDGE_REQUEST_TIMEOUT_MS=3000
MT5_BRIDGE_HEALTH_TIMEOUT_MS=1500

# This API intentionally exposes no LIVE enable variable.

# Phase 3E.5B DRY-RUN soak controller.
# This controller has no broker mutation path.
AUTO_EXECUTION_SOAK_ENABLED=false
AUTO_EXECUTION_SOAK_DRY_RUN=true
AUTO_EXECUTION_SOAK_INTERVAL_MS=60000
# Phase 3E.5E execution worker contract.
# Runtime worker wiring remains disabled until the controlled DEMO gate.
EXECUTION_WORKER_ENABLED=false
EXECUTION_WORKER_EXECUTION_ENABLED=false