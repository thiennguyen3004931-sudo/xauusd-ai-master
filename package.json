{
  "name": "xauusd-ai-master",
  "version": "1.0.0",
  "private": true,
  "description": "AI Trading Platform for XAUUSD",
  "packageManager": "pnpm@10.18.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "format": "prettier --write .",
    "check:integration": "node scripts/validate-pack-12.mjs",
    "dev:api": "turbo run dev --filter=@xauusd/api",
    "dev:web": "turbo run dev --filter=@xauusd/web"
  },
  "devDependencies": {
    "turbo": "^2.5.6",
    "typescript": "^5.9.2",
    "prettier": "^3.6.2"
  }
}
