# Phase 7B DEMO bridge only. Never point this file at a real account.
MT5_BRIDGE_HOST=127.0.0.1
MT5_BRIDGE_PORT=8765
MT5_API_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# DEMO execution is intentionally enabled in this dedicated env file.
MT5_TRADING_ENABLED=true
# Defense in depth: real-account trading remains disabled even when trading is enabled.
MT5_ALLOW_REAL_ACCOUNT=false
# REQUIRED before arming the bot: put the exact DEMO login printed by preflight here.
MT5_ALLOWED_LOGINS=

# Leave blank to use the currently logged-in terminal, or pin the DEMO terminal/account explicitly.
MT5_TERMINAL_PATH=C:\\Program Files\\MetaTrader 5\\terminal64.exe
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_PORTABLE=false
MT5_INITIALIZE_TIMEOUT_MS=60000
MT5_FAIL_STARTUP_IF_DISCONNECTED=true

MT5_SYMBOL_MAP_JSON={"XAUUSD":"XAUUSD"}
MT5_MAX_SPREAD_POINTS_JSON={"XAUUSD":65}

# Dedicated Phase 7B DEMO magic number.
MT5_MAGIC_NUMBER=270713
MT5_DEVIATION_POINTS=50
MT5_LEDGER_PATH=.\\data\\mt5_bridge_phase7b_demo.sqlite3
MT5_LOG_LEVEL=INFO
