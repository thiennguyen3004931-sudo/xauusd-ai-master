# Phase 7C LIVE bridge template.
# Copy this file locally to .env.phase7b-live. Never commit the populated file.
MT5_BRIDGE_HOST=127.0.0.1
MT5_BRIDGE_PORT=8765
MT5_API_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# Source-controlled LIVE template is deliberately disabled.
# Set true only in the local .env.phase7b-live after the account allowlist is correct.
MT5_TRADING_ENABLED=false
MT5_ALLOW_REAL_ACCOUNT=true
# REQUIRED for LIVE execution: exact LIVE login(s), comma separated.
MT5_ALLOWED_LOGINS=

# Leave login/password/server blank to use the account already logged into the target MT5 terminal,
# or configure them only in the local untracked .env.phase7b-live file.
MT5_TERMINAL_PATH=C:\\Program Files\\MetaTrader 5\\terminal64.exe
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_PORTABLE=false
MT5_INITIALIZE_TIMEOUT_MS=60000
MT5_FAIL_STARTUP_IF_DISCONNECTED=true

# MT5 normally exposes Unix UTC timestamps and this must stay 0.
# Only set a non-zero value after a read-only clock probe proves that a broker
# publishes server-local pseudo-UTC timestamps. Positive values mean broker
# timestamps are ahead of real UTC (for example, 10800 for a measured +03:00).
MT5_BROKER_TIME_OFFSET_SECONDS=0

# Canonical strategy symbol remains XAUUSD; the LIVE broker exposes it as XAUUSD.G.
MT5_SYMBOL_MAP_JSON={"XAUUSD":"XAUUSD.G"}
MT5_MAX_SPREAD_POINTS_JSON={"XAUUSD":65}

# LIVE uses a distinct magic/ledger from DEMO.
MT5_MAGIC_NUMBER=270715
MT5_DEVIATION_POINTS=50
MT5_LEDGER_PATH=.\\data\\mt5_bridge_phase7c_live.sqlite3
MT5_LOG_LEVEL=INFO
