# Bind locally. Do not expose this bridge directly to the public Internet.
MT5_BRIDGE_HOST=127.0.0.1
MT5_BRIDGE_PORT=8765
MT5_API_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# Safe default. Trading endpoints return HTTP 423 until this is true.
MT5_TRADING_ENABLED=false

# Real accounts require an additional explicit opt-in.
MT5_ALLOW_REAL_ACCOUNT=false

# Optional allow-list. Empty means use the terminal's current account.
MT5_ALLOWED_LOGINS=

# Optional terminal/login settings. Leave blank to use the currently logged-in terminal.
MT5_TERMINAL_PATH=C:\\Program Files\\MetaTrader 5\\terminal64.exe
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_PORTABLE=false
MT5_INITIALIZE_TIMEOUT_MS=60000
MT5_FAIL_STARTUP_IF_DISCONNECTED=true

# Canonical project symbol -> broker symbol. Adjust suffix/prefix for your broker.
MT5_SYMBOL_MAP_JSON={"XAUUSD":"XAUUSD"}

# Maximum spread in broker points for each canonical symbol.
MT5_MAX_SPREAD_POINTS_JSON={"XAUUSD":50}

MT5_MAGIC_NUMBER=260806
MT5_DEVIATION_POINTS=50
MT5_LEDGER_PATH=.\\data\\mt5_bridge.sqlite3
MT5_LOG_LEVEL=INFO
